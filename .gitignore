# Rerunnable benchmark output.
# NOTE: results/ is intentionally COMMITTED. Committed benchmark
# numbers and the environment spec they were measured in are the
# credibility signal in this repository. Only transient run output
# is ignored here.
bench_out/
*.bench.tmp

